# Copy to .env for local Docker use, or enter these values in Render.
# Never commit the copied .env file.
ConnectionStrings__NeonDBConnection=Server=YOUR_NEON_HOST;Database=neondb;User Id=YOUR_NEON_USER;Password=REPLACE_AFTER_ROTATION;SSL Mode=Require;Trust Server Certificate=true
Jwt__Key=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
Cors__AllowedOrigins__0=https://project-grogu-pi.vercel.app